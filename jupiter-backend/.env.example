PORT=5026
NODE_ENV="development"
# Local Docker PostgreSQL connection:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jupiter_db?schema=public"
# Supabase PostgreSQL connection (if using remote Supabase):
# DATABASE_URL="postgresql://postgres.yourprojectref:yourpassword@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
FRONTEND_URL="http://localhost:3026"
# Comma-separated allowed CORS origins
CORS_ORIGINS="http://localhost:3026,http://127.0.0.1:3026,https://jupitergroups.in,https://www.jupitergroups.in"

# Zoho SMTP Email Configuration
SMTP_HOST="smtp.zoho.in"
SMTP_PORT=465
SMTP_USER="marketing@jupitergroups.in"
SMTP_PASS="your-zoho-app-password"
SMTP_SECURE="true"
\n# JWT Authentication Secret\nJWT_SECRET="jupiter_auth_jwt_secure_secret_token_2026"\nADMIN_PASSWORD="admin123"\nADMIN_EMAIL="admin@jupiter.com"\n